APP_NAME=ERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Drives the 'private' disk in config/filesystems.php (avatars, documents,
# company logo). Leave as 'local' for Sail/dev and for the main
# docker-compose.prod.yml deploy path. Set to 's3' only for a deploy
# target with no durable local disk (e.g. Vercel's container Functions -
# see DEPLOY-VERCEL.md) and fill in the AWS_* vars below, Cloudflare R2 or
# any other S3-compatible provider both work.
PRIVATE_FILESYSTEM_DRIVER=local

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only read when PRIVATE_FILESYSTEM_DRIVER=s3 above. For Cloudflare R2:
# AWS_DEFAULT_REGION=auto, AWS_USE_PATH_STYLE_ENDPOINT=true, AWS_ENDPOINT=
# https://<account_id>.r2.cloudflarestorage.com, and AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY come from an R2 API token (not a Cloudflare
# account-wide API key).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
